    <mxCell id="p_banner_paquete_catalogo_y_tiendas" value="&lt;b&gt;DISEÑO CONCEPTUAL Y LÓGICO DETALLADO — PAQUETE 2: CATÁLOGO Y TIENDAS&lt;/b&gt;&lt;br&gt;Sucursales, categorización, colecciones, matriz de variantes (color/talla), fotos, reseñas, cupones, promociones y wishlists (CU06, CU07, CU09, CU11-CU14) · 16 Tablas Físicas Normalizadas (PostgreSQL 3NF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#047857;strokeColor=#065f46;fontColor=#ffffff;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="2300" height="50" as="geometry" /></mxCell>
