  <diagram id="page_global_arch" name="1. Arquitectura Global (8 Paquetes)">
    <mxGraphModel dx="2800" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="banner" value="&lt;b&gt;ARQUITECTURA DE DATOS GLOBAL - 8 PAQUETES DEL SISTEMA FASHIONSTORE&lt;/b&gt;&lt;br&gt;Universidad Autónoma Gabriel René Moreno · SI 2 · Grupo 29 | Mapeo Relacional de 50 Tablas en 8 Paquetes Cohesivos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#f8fafc;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1800" height="50" as="geometry" /></mxCell>
    <mxCell id="pkg_card_paquete_seguridad_usuarios" value="&lt;b&gt;Paquete 1: Seguridad y Usuarios&lt;/b&gt;&lt;br&gt;&lt;i&gt;5 Tablas&lt;/i&gt;&lt;br&gt;&lt;hr&gt;Autenticación JWT, RBAC multi-rol, sesiones concurrentes y bitácora inmutable de auditoría (CU01-CU05, CU36)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tablas del Módulo:&lt;/b&gt;&lt;br&gt;• roles&lt;br&gt;• users&lt;br&gt;• user_roles&lt;br&gt;• session_tokens&lt;br&gt;• audit_logs" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#eff6ff;strokeColor=#1e40af;strokeWidth=2;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="400" height="340" as="geometry" /></mxCell>
    <mxCell id="pkg_card_paquete_catalogo_y_tiendas" value="&lt;b&gt;Paquete 2: Catálogo y Tiendas&lt;/b&gt;&lt;br&gt;&lt;i&gt;16 Tablas&lt;/i&gt;&lt;br&gt;&lt;hr&gt;Sucursales, categorización, colecciones, matriz de variantes (color/talla), fotos, reseñas, cupones, promociones y wishlists (CU06, CU07, CU09, CU11-CU14)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tablas del Módulo:&lt;/b&gt;&lt;br&gt;• branches&lt;br&gt;• branch_employees&lt;br&gt;• categories&lt;br&gt;• seasons&lt;br&gt;• collections&lt;br&gt;• colors&lt;br&gt;• sizes&lt;br&gt;• products&lt;br&gt;• product_variants&lt;br&gt;• product_images&lt;br&gt;• product_reviews&lt;br&gt;• wishlist_items&lt;br&gt;• coupons&lt;br&gt;• seasonal_promotions&lt;br&gt;• wishlists&lt;br&gt;• wishlist_group_items" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="120" width="400" height="340" as="geometry" /></mxCell>
    <mxCell id="pkg_card_paquete_inventario_y_proveedores" value="&lt;b&gt;Paquete 3: Inventario y Proveedores&lt;/b&gt;&lt;br&gt;&lt;i&gt;7 Tablas&lt;/i&gt;&lt;br&gt;&lt;hr&gt;Proveedores, órdenes de compra por sucursal, kardex valorado (CPP), stock multi-sucursal y transferencias entre tiendas (CU08, CU10, CU15, CU16, CU37, CU38)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tablas del Módulo:&lt;/b&gt;&lt;br&gt;• suppliers&lt;br&gt;• inventory&lt;br&gt;• inventory_ledger&lt;br&gt;• purchase_orders&lt;br&gt;• purchase_details&lt;br&gt;• stock_transfers&lt;br&gt;• stock_transfer_details" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="400" height="340" as="geometry" /></mxCell>
    <mxCell id="pkg_card_paquete_ventas_y_pagos" value="&lt;b&gt;Paquete 4: Ventas y Pagos&lt;/b&gt;&lt;br&gt;&lt;i&gt;11 Tablas&lt;/i&gt;&lt;br&gt;&lt;hr&gt;Carrito, arqueo POS, pedidos omnicanal, pagos polimórficos STI (Efectivo/Tarjeta/QR/PayPal/Crédito), facturación IVA 13%, cotizaciones y devoluciones (CU17-CU25)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tablas del Módulo:&lt;/b&gt;&lt;br&gt;• carts&lt;br&gt;• cart_items&lt;br&gt;• cash_shifts&lt;br&gt;• orders&lt;br&gt;• order_items&lt;br&gt;• payments&lt;br&gt;• invoices&lt;br&gt;• quotations&lt;br&gt;• quotation_items&lt;br&gt;• order_returns&lt;br&gt;• order_return_items" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#fef2f2;strokeColor=#b91c1c;strokeWidth=2;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1440" y="120" width="400" height="340" as="geometry" /></mxCell>
    <mxCell id="pkg_card_paquete_reservas_y_citas" value="&lt;b&gt;Paquete 5: Reservas y Citas&lt;/b&gt;&lt;br&gt;&lt;i&gt;2 Tablas&lt;/i&gt;&lt;br&gt;&lt;hr&gt;Citas en probadores de sucursal con seña obligatoria (50%), bloqueo de stock, tolerancia 15/30 min y conversión directa a venta (CU26-CU28, CU25)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tablas del Módulo:&lt;/b&gt;&lt;br&gt;• reservations&lt;br&gt;• reservation_items" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#faf5ff;strokeColor=#6d28d9;strokeWidth=2;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="400" height="340" as="geometry" /></mxCell>
    <mxCell id="pkg_card_paquete_envios_y_logistica" value="&lt;b&gt;Paquete 6: Envíos y Logística&lt;/b&gt;&lt;br&gt;&lt;i&gt;4 Tablas&lt;/i&gt;&lt;br&gt;&lt;hr&gt;Zonas y tarifas por distancia, repartidores (bolsa), tracking en tiempo real de ruta y entrega con foto obligatoria (CU29-CU31)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tablas del Módulo:&lt;/b&gt;&lt;br&gt;• delivery_zones&lt;br&gt;• delivery_persons&lt;br&gt;• shipments&lt;br&gt;• shipment_tracking_events" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="520" width="400" height="340" as="geometry" /></mxCell>
    <mxCell id="pkg_card_paquete_inteligente_y_analitica" value="&lt;b&gt;Paquete 7: Inteligencia Artificial y Analítica&lt;/b&gt;&lt;br&gt;&lt;i&gt;4 Tablas&lt;/i&gt;&lt;br&gt;&lt;hr&gt;Probador virtual con simulación de ajuste (VTON/FASHN.ai), capturas fotorrealistas con recomendación de talla y chatbot con detección de intenciones (CU32-CU35, CU39)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tablas del Módulo:&lt;/b&gt;&lt;br&gt;• virtual_tryon_sessions&lt;br&gt;• virtual_tryon_items&lt;br&gt;• virtual_tryon_captures&lt;br&gt;• chatbot_conversations" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#f8fafc;strokeColor=#374151;strokeWidth=2;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="520" width="400" height="340" as="geometry" /></mxCell>
    <mxCell id="pkg_card_paquete_notificaciones" value="&lt;b&gt;Paquete 8: Notificaciones&lt;/b&gt;&lt;br&gt;&lt;i&gt;1 Tablas&lt;/i&gt;&lt;br&gt;&lt;hr&gt;Bandeja de notificaciones in-app y alertas push en tiempo real sobre pedidos, citas, stock y envíos (CU40)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tablas del Módulo:&lt;/b&gt;&lt;br&gt;• in_app_notifications" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=12;fillColor=#f1f5f9;strokeColor=#1e293b;strokeWidth=2;fontColor=#0f172a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1440" y="520" width="400" height="340" as="geometry" /></mxCell>
