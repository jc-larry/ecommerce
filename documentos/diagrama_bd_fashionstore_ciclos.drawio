    <mxCell id="p_banner_paquete_seguridad_usuarios" value="&lt;b&gt;DISEÑO CONCEPTUAL Y LÓGICO DETALLADO — PAQUETE 1: SEGURIDAD Y USUARIOS&lt;/b&gt;&lt;br&gt;Autenticación JWT, RBAC multi-rol, sesiones concurrentes y bitácora inmutable de auditoría (CU01-CU05, CU36) · 5 Tablas Físicas Normalizadas (PostgreSQL 3NF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e40af;strokeColor=#1e3a8a;fontColor=#ffffff;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="2300" height="50" as="geometry" /></mxCell>
