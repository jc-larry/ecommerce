    <mxCell id="p_banner_paquete_inteligente_y_analitica" value="&lt;b&gt;DISEÑO CONCEPTUAL Y LÓGICO DETALLADO — PAQUETE 7: INTELIGENCIA ARTIFICIAL Y ANALÍTICA&lt;/b&gt;&lt;br&gt;Probador virtual con simulación de ajuste (VTON/FASHN.ai), capturas fotorrealistas con recomendación de talla y chatbot con detección de intenciones (CU32-CU35, CU39) · 4 Tablas Físicas Normalizadas (PostgreSQL 3NF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#374151;strokeColor=#1f2937;fontColor=#ffffff;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="2300" height="50" as="geometry" /></mxCell>
