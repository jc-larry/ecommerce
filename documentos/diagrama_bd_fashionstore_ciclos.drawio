    <mxCell id="p_banner_paquete_ventas_y_pagos" value="&lt;b&gt;DISEÑO CONCEPTUAL Y LÓGICO DETALLADO — PAQUETE 4: VENTAS Y PAGOS&lt;/b&gt;&lt;br&gt;Carrito, arqueo POS, pedidos omnicanal, pagos polimórficos STI (Efectivo/Tarjeta/QR/PayPal/Crédito), facturación IVA 13%, cotizaciones y devoluciones (CU17-CU25) · 11 Tablas Físicas Normalizadas (PostgreSQL 3NF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b91c1c;strokeColor=#991b1b;fontColor=#ffffff;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="2300" height="50" as="geometry" /></mxCell>
    <mxCell id="legend_paquete_ventas_y_pagos" value="&lt;b&gt;CONVENCIONES UML / ER:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;+ id : SERIAL [PK]&lt;/b&gt; = Clave Primaria&lt;br&gt;• &lt;i&gt;# fk_id : INTEGER [FK]&lt;/i&gt; = Clave Foránea&lt;br&gt;• &lt;b&gt;[UQ]&lt;/b&gt; = Único | &lt;b&gt;[NOT NULL]&lt;/b&gt; = Obligatorio&lt;br&gt;• &lt;b&gt;[Ref Externa]&lt;/b&gt; = Tabla de otro paquete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#334155;fontSize=10;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="1980" y="100" width="280" height="90" as="geometry" /></mxCell>
